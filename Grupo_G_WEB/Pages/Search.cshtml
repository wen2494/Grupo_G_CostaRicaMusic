@page "/search"
@model SearchModel
@{
    ViewData["Title"] = "Buscar";
}

<section class="route-card">
    <div class="section-heading">
        <p class="eyebrow">Explorar</p>
        <h2>Buscar</h2>
    </div>

    <h3>Canciones</h3>
    @if (Model.Canciones.Count == 0)
    {
        <p>No se encontraron canciones.</p>
    }
    else
    {
        <div class="track-list compact">
            @foreach (var song in Model.Canciones)
            {
                var cover = song.UrlImagenCancion ?? song.UrlPortadaAlbum;
                <button type="button"
                        class="track-btn"
                        data-track-id="@song.Id"
                        data-src="@song.RutaArchivo"
                        data-title="@song.NombreCancion"
                        data-artist="@song.NombreArtista"
                        data-album="@song.NombreAlbum"
                        data-cover="@cover">
                    <span class="track-cover" style="@(string.IsNullOrWhiteSpace(cover) ? null : $"background-image: url('{cover}')")"></span>
                    <span class="track-copy">
                        <span class="track-title">@song.NombreCancion</span>
                        <span class="track-meta">@song.NombreArtista · @song.NombreAlbum</span>
                    </span>
                </button>
            }
        </div>
    }

    <h3>Artistas</h3>
    <div class="media-grid">
        @foreach (var artist in Model.Artistas)
        {
            <a asp-page="/Artist" asp-route-id="@artist.Id" class="media-tile">
                <span class="media-thumb artist-artwork" style="@(string.IsNullOrWhiteSpace(artist.UrlImagen) ? null : $"background-image: url('{artist.UrlImagen}')")"></span>
                <span>@artist.Nombre</span>
            </a>
        }
    </div>

    <h3>Albumes</h3>
    <div class="media-grid">
        @foreach (var album in Model.Albumes)
        {
            <a asp-page="/Album" asp-route-id="@album.Id" class="media-tile">
                <span class="media-thumb" style="@(string.IsNullOrWhiteSpace(album.UrlPortada) ? null : $"background-image: url('{album.UrlPortada}')")"></span>
                <span>@album.Nombre</span>
            </a>
        }
    </div>
</section>
