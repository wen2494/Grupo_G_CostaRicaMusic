@page
@model IndexModel
@{
    ViewData["Title"] = "Inicio";
}

<section class="hero-card">
    <p class="eyebrow">Costa Rica Music</p>
    <h1>Tu musica ahora viene del backend real.</h1>
    <p class="small-note">Selecciona una cancion y usa el reproductor inferior para controlar la reproduccion.</p>
</section>

<section class="home-grid">
    <div class="library-card">
        <div class="section-heading">
            <h2>Catalogo disponible</h2>
            <p class="small-note">@Model.Canciones.Count canciones listas para probar.</p>
        </div>

        @if (Model.Canciones.Count == 0)
        {
            <p>No hay canciones disponibles.</p>
        }
        else
        {
            <div class="track-list">
                @foreach (var cancion in Model.Canciones)
                {
                    <button type="button"
                            class="track-btn"
                            data-track-id="@cancion.Id"
                            data-src="@cancion.RutaArchivo"
                            data-title="@cancion.NombreCancion"
                            data-artist="@cancion.NombreArtista"
                            data-album="@cancion.NombreAlbum">
                        <span class="track-title">@cancion.NombreCancion</span>
                        <span class="track-meta">@cancion.NombreArtista · @cancion.NombreAlbum</span>
                    </button>
                }
            </div>
        }
    </div>

    <div class="player-card">
        <p class="now-playing-label">Demo funcional</p>
        <h2>Reproductor conectado</h2>
        <p class="small-note">La portada, busqueda, albumes, artistas y playlists usan la misma API para reproducir audio.</p>
    </div>
</section>
