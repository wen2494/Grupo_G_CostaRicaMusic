@page "/artist/{id:int}"
@model ArtistModel
@{
    ViewData["Title"] = "Artista";
}

<section class="route-card">
    <h2>Artista</h2>

    @if (Model.Artista is null)
    {
        <p>Artista no encontrado.</p>
    }
    else
    {
        <h3>@Model.Artista.Nombre</h3>
        <p class="small-note">@Model.Artista.Biografia</p>

        <div class="track-list compact">
            @foreach (var cancion in Model.Canciones)
            {
                <button type="button"
                        class="track-btn"
                        data-track-id="@cancion.Id"
                        data-src="@cancion.RutaArchivo"
                        data-title="@cancion.NombreCancion"
                        data-artist="@cancion.NombreArtista"
                        data-album="@cancion.NombreAlbum">
                    <span class="track-title">@cancion.NombreCancion</span>
                    <span class="track-meta">@cancion.NombreAlbum</span>
                </button>
            }
        </div>
    }
</section>
