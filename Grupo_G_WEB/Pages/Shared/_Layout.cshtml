@using Grupo_G_WEB.Services
@inject IMusicCatalogService CatalogService
@{
    var sessionUserId = Context.Session.GetInt32("UserId");
    var sessionDisplayName = Context.Session.GetString("DisplayName");
    IReadOnlyList<Grupo_G_WEB.Models.Playlist> sidebarPlaylists = sessionUserId is null ? [] : await CatalogService.GetPlaylistsAsync(sessionUserId.Value);
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
    var currentPlaylistId = ViewContext.RouteData.Values["id"]?.ToString();
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Costa Rica Music</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Grupo_G_WEB.styles.css" asp-append-version="true" />
</head>

<body>
    <div class="app-shell">
        <aside class="app-sidebar">
            <a class="brand" asp-page="/Index">
                <i class="bi bi-vinyl-fill"></i>
                <span>Costa Rica Music</span>
            </a>

            <div class="user-chip">
                @if (sessionUserId is null)
                {
                    <a asp-page="/Login"><i class="bi bi-box-arrow-in-right"></i><span>Entrar</span></a>
                    <a asp-page="/Register">Crear</a>
                }
                else
                {
                    <span><i class="bi bi-person-circle"></i>@sessionDisplayName</span>
                    <a asp-page="/Logout">Salir</a>
                }
            </div>

            <nav class="app-nav" aria-label="Navegacion principal">
                <a asp-page="/Index" class="@(currentPage == "/Index" ? "is-active" : null)">
                    <i class="bi bi-house-door-fill"></i>
                    <span>Inicio</span>
                </a>

                <a asp-page="/Search" class="@(currentPage == "/Search" ? "is-active" : null)">
                    <i class="bi bi-search"></i>
                    <span>Buscar</span>
                </a>

                <a asp-page="/Playlist" class="@(currentPage == "/Playlist" && string.IsNullOrWhiteSpace(currentPlaylistId) ? "is-active" : null)">
                    <i class="bi bi-music-note-list"></i>
                    <span>Playlists</span>
                </a>

                <a asp-page="/Artist" class="@(currentPage == "/Artist" ? "is-active" : null)">
                    <i class="bi bi-person-badge"></i>
                    <span>Artistas</span>
                </a>

                <a asp-page="/Album" class="@(currentPage == "/Album" ? "is-active" : null)">
                    <i class="bi bi-disc"></i>
                    <span>Albumes</span>
                </a>
            </nav>

            <section class="sidebar-playlists">
                <div class="sidebar-section-header">
                    <p class="sidebar-kicker">Tu biblioteca</p>
                    <a asp-page="/Playlist" class="sidebar-manage-link">Gestionar</a>
                </div>

                @if (sidebarPlaylists.Count == 0)
                {
                    <p class="small-note">Sin playlists.</p>
                }
                else
                {
                    <div class="sidebar-playlist-list">
                        @foreach (var playlist in sidebarPlaylists)
                        {
                            var isActivePlaylist = currentPage == "/Playlist" && currentPlaylistId == playlist.Id.ToString();
                            <a asp-page="/Playlist"
                               asp-route-id="@playlist.Id"
                               class="sidebar-playlist-link @(isActivePlaylist ? "is-active" : null)">
                                <span class="sidebar-playlist-name">@playlist.Nombre</span>
                                <span class="sidebar-playlist-caption">Playlist compartida</span>
                            </a>
                        }
                    </div>
                }
            </section>
        </aside>

        <div class="app-main-area">
            <header class="app-topbar">
                <form method="get" asp-page="/Search" class="top-search" role="search">
                    <input type="search" name="q" placeholder="Buscar" />
                    <button type="submit">
                        <i class="bi bi-search"></i>
                    </button>
                </form>
            </header>

            <main class="app-content" role="main">
                @RenderBody()
            </main>
        </div>

        <aside class="app-right-panel">
            <h3><i class="bi bi-music-note-beamed"></i> Sonando</h3>
            <div class="now-playing-card">
                <div id="sideArtwork" class="now-playing-artwork">CRM</div>
                <div>
                    <p id="sideNowPlayingTitle">Elige una cancion</p>
                    <p id="sideNowPlayingArtist" class="small-note">-</p>
                    <p id="sideNowPlayingAlbum" class="small-note">-</p>
                </div>
            </div>

            <hr />

            <div class="queue-panel">
                <div class="queue-panel-header">
                    <h4><i class="bi bi-lightning-fill"></i> Sigue</h4>
                    <span id="queueCount" class="small-note">0 canciones</span>
                </div>
                <div id="upNextList" class="up-next-list">
                    <p class="small-note">Sin cola.</p>
                </div>
            </div>
        </aside>
    </div>

    <footer class="global-player" aria-label="Reproductor global">
        <div class="player-track-meta">
            <div id="globalArtwork" class="global-artwork">CRM</div>
            <div class="player-meta-copy">
                <p class="now-playing-label">Reproduciendo</p>
                <h3 id="globalNowPlayingTitle">Selecciona una cancion</h3>
                <p id="globalNowPlayingArtist">-</p>
                <p id="globalNowPlayingAlbum" class="player-subtitle">-</p>
            </div>
        </div>

        <div class="player-center-stack">
            <div class="player-controls">
                <button id="playCollectionBtn" type="button" class="icon-btn" aria-label="Reproducir la lista actual">
                    <i class="bi bi-music-note-list"></i>
                </button>
                <button id="shuffleBtn" type="button" class="icon-btn" aria-label="Activar reproduccion aleatoria">
                    <i class="bi bi-shuffle"></i>
                </button>
                <button id="prevTrackBtn" type="button" class="icon-btn" aria-label="Cancion anterior">
                    <i class="bi bi-skip-start-fill"></i>
                </button>
                <button id="playPauseBtn" type="button" class="icon-btn play-btn" aria-label="Reproducir o pausar">
                    <i class="bi bi-play-fill"></i>
                </button>
                <button id="nextTrackBtn" type="button" class="icon-btn" aria-label="Cancion siguiente">
                    <i class="bi bi-skip-end-fill"></i>
                </button>
                <button id="repeatBtn" type="button" class="icon-btn" aria-label="Repetir cancion actual">
                    <i class="bi bi-repeat"></i>
                </button>
            </div>

            <div class="progress-container">
                <div class="progress-header">
                    <label for="seekBar">Progreso</label>
                    <div class="time-row">
                        <span id="currentTimeLabel">0:00</span>
                        <span id="durationLabel">0:00</span>
                    </div>
                </div>
                <input id="seekBar" class="progress-bar" type="range" min="0" max="100" value="0" step="1" />
            </div>
        </div>

        <div class="volume-container">
            <label for="volumeBar">Volumen</label>
            <div class="volume-shell">
                <i class="bi bi-volume-up-fill"></i>
                <input id="volumeBar" class="volume-bar" type="range" min="0" max="1" value="1" step="0.05" />
            </div>
        </div>

        <audio id="musicPlayer" preload="none">
            Tu navegador no soporta audio HTML5.
        </audio>
    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
